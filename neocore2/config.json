          "mount": "",
          "path": null,
          "pattern": "*",
          "priority": 80,
          "type": "container_glob"
        },
        {
          "dir": "content/",
          "mount": "",
          "path": null,
          "pattern": "*",
          "priority": 60,
          "type": "container_glob"
        }
      ],
      "pump_steps": 16
    },
    "engine.fps.character": {
      "runtime_data": {
        "locomotion_graph": "animation/humanoid_locomotion.graph.v1.json"
      }
    },
    "engine.input.compass": {
      "device_mode": "hybrid",
      "enabled": true,
      "gamepad": true,
      "gamepad_backend": "xinput",
      "host": {
        "enabled": true
      },
      "keyboard": true,
      "mouse": true
    },
    "engine.loading": {
      "brand_id": "brand.gamefps.northstar",
      "display_name": "North Star gameFps",
      "enabled": true,
      "manifest_id": "app.gamefps.loading",
      "prestart": {
        "background": "textures/ui/loading/loaderWindow.ytd@north_star_preload_background",
        "logo": "textures/ui/loading/loaderWindow.ytd@north_star_engine_logo",
        "spinner": "textures/ui/loading/loaderWindow.ytd@north_star_loading_spinner"
      },
      "replace_policy": "consumer_profile_override",
      "runtime_loading": {
        "background": "textures/ui/loading/loaderWindow.ytd@north_star_preload_background",
        "logo": "textures/ui/loading/loaderWindow.ytd@north_star_engine_logo",
        "spinner": "textures/ui/loading/loaderWindow.ytd@north_star_loading_spinner"
      },
      "spinner_animation": {
        "frame_height": 64,
        "frame_width": 64,
        "rotation_rps": 0.9,
        "sprite_columns": 1,
        "sprite_fps": 24.0,
        "sprite_frames": 1,
        "sprite_rows": 1
      }
    },
    "engine.logging.chronicle": {
      "dedup": {
        "capacity": 4096,
        "window_ms": 1000
      },
      "enabled": true,
      "host": {
        "enabled": true
      },
      "rolling": {
        "keep_days": 7,
        "max_bytes": 33554432,
        "max_files": 4
      },
      "sources": {
        "console": {
          "colors": true,
          "enabled": true,
          "level": "debug",
          "target": "stderr"
        },
        "file": {
          "enabled": false,
          "level": "info",
          "mode": "append"
        },
        "ulog": {
          "enabled": true,
          "level": "info",
          "path": "logs/current.ulog.ndjson"
        }
      },
      "timestamp": "millis"
    },
