          "mount": "shared",
          "path": null,
          "pattern": "*",
          "priority": 210,
          "type": "container_glob"
        },
        {
          "dir": null,
          "mount": "",
          "path": "ROOT-DIR/Shared/Content",
          "pattern": null,
          "priority": 240,
